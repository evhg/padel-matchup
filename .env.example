# --- Database (Supabase Postgres) ---------------------------------------------
# Paste the "Transaction pooler" string from Supabase → Connect (port 6543).
# You may leave [YOUR-PASSWORD] in it and put the password in DATABASE_PASSWORD;
# the app fills it in and percent-encodes it for you.
# Leave EMPTY for zero-config local dev: the app falls back to an embedded
# PGlite database stored in ./.pglite and seeds an example match automatically.
DATABASE_URL=
DATABASE_PASSWORD=
# Direct connection (port 5432) used only by `pnpm db:migrate`. Optional:
# the app applies migrations itself on first connection (AUTO_MIGRATE=false to disable).
DIRECT_DATABASE_URL=

# --- Email (Resend) -----------------------------------------------------------
# Optional. When missing, ALL email features are silently disabled (UI hidden).
RESEND_API_KEY=
EMAIL_FROM="Kicksmash <matches@kicksma.sh>"

# --- App ----------------------------------------------------------------------
# Public origin used in share links, emails and OG images. No trailing slash.
# On Vercel this defaults to the project's production domain automatically.
APP_BASE_URL=http://localhost:3000
# Optional but recommended: protects /api/cron/hourly. Vercel sends it automatically.
CRON_SECRET=
# Optional but recommended: signs the identity cookie (≥ 32 random chars).
# Without it, a stable secret is derived from the database URL.
SESSION_SECRET=
