# --- Database (Supabase Postgres) ---------------------------------------------
# Paste the "Transaction pooler" string from Supabase → Connect (port 6543).
# You may leave [YOUR-PASSWORD] in it and put the password in DATABASE_PASSWORD;
# the app fills it in and percent-encodes it for you.
# Leave EMPTY for zero-config local dev: the app falls back to an embedded
# PGlite database stored in ./.pglite and seeds an example match automatically.
DATABASE_URL=
DATABASE_PASSWORD=
# Direct connection (port 5432) used only by `pnpm db:migrate`. Optional:
# the app applies migrations itself on first connection (AUTO_MIGRATE=false to disable).
DIRECT_DATABASE_URL=

# --- Email (Resend) -----------------------------------------------------------
# Optional. When missing, ALL email features are silently disabled (UI hidden).
RESEND_API_KEY=
EMAIL_FROM="Kicksmash <matches@kicksma.sh>"

# --- App ----------------------------------------------------------------------
# Public origin used in share links, emails and OG images. No trailing slash.
# On Vercel this defaults to the project's production domain automatically.
APP_BASE_URL=http://localhost:3000
# Optional but recommended: protects /api/cron/hourly. Vercel sends it automatically.
CRON_SECRET=
# Optional but recommended: signs the identity cookie (≥ 32 random chars).
# Without it, a stable secret is derived from the database URL.
SESSION_SECRET=

# --- Push reminders (Web Push / VAPID) ---------------------------------------
# Optional. Generate once with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Local database location ------------------------------------------------
# Where the embedded PGlite database lives when DATABASE_URL is empty (default ./.pglite).
# PGLITE_DATA_DIR=

# --- Telegram bot (@kicksmash_bot) ---------------------------------------------
# Token from @BotFather; a random secret Telegram echoes back on every webhook call;
# the bot's username without @. Register the webhook once: GET /api/telegram/setup
# with "Authorization: Bearer $CRON_SECRET". Leave empty to run without the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# --- Drafting assistant (community answers, R3) -------------------------------
# Anthropic API key with a monthly spend cap. Leave empty to disable drafting.
ANTHROPIC_API_KEY=
# The owner's numeric Telegram id (send /start to the bot, then read it from the players table). Drafts are
# sent there for a one-tap Approve / Skip, and /admin/listen opens only for that account.
TELEGRAM_OWNER_ID=
# Optional: model for drafts (default claude-sonnet-5).
LISTEN_MODEL=

# --- Posting approved replies on Reddit (optional; script app of the project's account) -------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

