# --- Database (Supabase Postgres) ---------------------------------------------
# Transaction-pooler URL (port 6543) used by the app at runtime on Vercel.
# Leave EMPTY for zero-config local dev: the app falls back to an embedded
# PGlite database stored in ./.pglite and seeds an example match automatically.
DATABASE_URL=
# Direct connection (port 5432) used only by migrations (pnpm db:migrate / db:push).
DIRECT_DATABASE_URL=

# --- Email (Resend) -----------------------------------------------------------
# Optional. When missing, ALL email features are silently disabled (UI hidden).
RESEND_API_KEY=
EMAIL_FROM="Kicksmash <matches@kicksma.sh>"

# --- App ----------------------------------------------------------------------
# Public origin used in share links, emails and OG images. No trailing slash.
APP_BASE_URL=http://localhost:3000
# Protects /api/cron/hourly. Vercel injects "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=change-me-to-a-long-random-string
# Signs the identity cookie. Rotate = every visitor re-enters their name.
SESSION_SECRET=change-me-to-another-long-random-string
