# Kicksmash configuration. Written by scripts/gen-docs.mjs; every variable the code reads is here.
# Nothing below is required for local development: with no DATABASE_URL the app boots an embedded
# database, and every feature whose keys are missing hides itself.

# Supabase Transaction pooler string (port 6543), exactly as Supabase's Connect dialog shows it. POSTGRES_URL (the Vercel ⇄ Supabase integration) and SUPABASE_DB_URL work too. Empty → the embedded PGlite database, for local development only.
# Required in production.
DATABASE_URL=

# Substituted into the URL and percent-encoded for you.
# Required if the URL still says [YOUR-PASSWORD].
DATABASE_PASSWORD=

# Direct (port 5432) URL for pnpm db:migrate and pnpm db:generate. POSTGRES_URL_NON_POOLING works too.
DIRECT_DATABASE_URL=

# false stops the app applying migrations on its first connection. That safety net is for a fresh database only: production gets each migration by hand (AGENTS.md rule 7).
AUTO_MIGRATE=

# Defaults to the Vercel production domain. Set it locally and on other hosts. NEXT_PUBLIC_APP_BASE_URL is the browser's copy of the same value.
APP_BASE_URL=

# Signs the identity cookie. Without it a stable secret is derived from the database URL.
# Recommended in production.
SESSION_SECRET=

# Protects /api/cron/* and the one-off setup routes. Vercel sends it automatically when set.
# Recommended in production.
CRON_SECRET=

# Enables every email: calendar invitations, notifications, reminders.
RESEND_API_KEY=

# Defaults to Kicksmash <matches@<your domain>>; the domain must be verified in Resend.
EMAIL_FROM=

# Verifies Resend's inbound webhook, so a reply to feedback@ or claude@ becomes a note.
RESEND_WEBHOOK_SECRET=

# The From line on outreach mail. Defaults to Claude at Kicksmash <claude@<your domain>>.
OUTREACH_FROM=

# Enables push reminders (npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Enables the Telegram bot and Telegram sign-in. Register the webhook once with GET /api/telegram/setup (Bearer CRON_SECRET).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# The Mini App's short name, so cards can carry a direct link into it.
TELEGRAM_MINIAPP_SLUG=

# The owner's Telegram id: proposals, club claims and drafts go there for a one-tap answer, and the admin desks open for that account only.
TELEGRAM_OWNER_ID=

# Enables the Discord bot. Register the commands and the interactions URL once with GET /api/discord/setup (Bearer CRON_SECRET); it returns the install link. DISCORD_APPLICATION_ID is read from the token unless set; DISCORD_INVITE_URL shows the server on the community pages.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Ed25519 pair (raw 32-byte hex each) that signs player passports. Without them a passport carries alg: "none".
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Drafts the replies on the listening desk and the proposal the owner receives for a note. LISTEN_MODEL overrides the model; ANTHROPIC_MONTHLY_CAP_USD (default 20) is the ceiling the app keeps itself under; ANTHROPIC_ADMIN_KEY lets the service board read the real spend.
ANTHROPIC_API_KEY=

# The research desk: clubs and coaches per city, and grounding for answer pages.
TAVILY_API_KEY=

# Lets an approved reply be posted on Reddit as the project's account. Without them, Approve means copy and paste.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# A service account with Search Console access, so the service board can read impressions and clicks.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Tells Bing and Yandex a page changed, the moment it changes.
INDEXNOW_KEY=

# The nightly database snapshot is committed to that repository.
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_REPO=

# owner/repo of the GitHub Actions uptime probe, so the service board can read its open incidents.
UPTIME_REPO=

# Names the Vercel project, so a missing key can be reported with the link that sets it.
OPERATOR_VERCEL_TEAM=
OPERATOR_VERCEL_PROJECT=
